package com.Bank.bank_app.controller;

import com.Bank.bank_app.dto.Account_dto;
import com.Bank.bank_app.dto.LoginRequest;
import com.Bank.bank_app.entity.Account;
import com.Bank.bank_app.entity.Transaction;
import com.Bank.bank_app.exception.ResourceNotFoundException;
import com.Bank.bank_app.repository.AccountRepository;
import com.Bank.bank_app.repository.TransactionRepository;
import com.Bank.bank_app.service.AccountService;
import com.Bank.bank_app.service.OtpService;
import jakarta.validation.Valid;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.HashMap;
import java.util.List;
import java.util.Map;

@RestController
@RequestMapping("/api/accounts")
@CrossOrigin(origins = "http://localhost:4200")
public class AccountController {

    private final AccountService service;
    private final TransactionRepository txnRepo;
    private final AccountRepository accountRepository;
    private final OtpService otpService;

    public AccountController(AccountService service, TransactionRepository txnRepo,
                            AccountRepository accountRepository, OtpService otpService) {
        this.service = service;
        this.txnRepo = txnRepo;
        this.accountRepository = accountRepository;
        this.otpService = otpService;
    }

    @PostMapping
    public ResponseEntity<Account_dto> create(@Valid @RequestBody Account_dto dto) {
        return ResponseEntity.ok(service.createAccount(dto));
    }

    @PostMapping("/login")
    public ResponseEntity<Account_dto> login(@Valid @RequestBody LoginRequest dto) {
        return ResponseEntity.ok(service.login(dto.getUsername(), dto.getPassword()));
    }

    @GetMapping("/{username}")
    public ResponseEntity<Account_dto> getAccount(@PathVariable String username) {
        return ResponseEntity.ok(service.getByUsername(username));
    }

    @PostMapping("/send-mobile-otp")
    public ResponseEntity<Map<String, String>> sendMobileOtp(@RequestParam String username,
                                                            @RequestParam String mobileNumber) {
        Account account = accountRepository.findByUsername(username)
                .orElseThrow(() -> new ResourceNotFoundException("User not found: " + username));

        account.setMobileNumber(mobileNumber);
        account.setMobileVerified(false);
        accountRepository.save(account);

        otpService.sendOtp(mobileNumber);

        Map<String, String> response = new HashMap<>();
        response.put("message", "OTP sent to mobile number: " + mobileNumber);
        return ResponseEntity.ok(response);
    }

    @PostMapping("/verify-mobile")
    public ResponseEntity<Map<String, Object>> verifyMobile(@RequestParam String username,
                                                            @RequestParam String mobileNumber,
                                                            @RequestParam String otp) {
        Account account = accountRepository.findByUsername(username)
                .orElseThrow(() -> new ResourceNotFoundException("User not found: " + username));

        if (!mobileNumber.equals(account.getMobileNumber())) {
            throw new RuntimeException("This mobile number is not linked to this account");
        }

        otpService.verifyOtp(mobileNumber, otp);
        account.setMobileVerified(true);
        accountRepository.save(account);

        Map<String, Object> response = new HashMap<>();
        response.put("message", "Mobile number verified successfully");
        response.put("mobileVerified", true);
        response.put("upiId", account.getUpiId());
        return ResponseEntity.ok(response);
    }

    @PutMapping("/add-money/{username}/{amount}")
    public ResponseEntity<Account_dto> addMoney(
            @PathVariable String username,
            @PathVariable double amount) {
        return ResponseEntity.ok(service.addMoney(username, amount));
    }

    @PutMapping("/withdraw/{username}/{amount}")
    public ResponseEntity<?> withdraw(
            @PathVariable String username,
            @PathVariable double amount) {
        return ResponseEntity.ok(service.withdraw(username, amount));
    }

    @GetMapping("/transactions/{username}")
    public ResponseEntity<List<Transaction>> getTransactions(@PathVariable String username) {
        return ResponseEntity.ok(txnRepo.findByUsernameOrderByIdDesc(username));
    }

    @PutMapping("/transfer/{username}/{toAcc}/{ifsc}/{amount}")
    public ResponseEntity<?> transfer(
            @PathVariable String username,
            @PathVariable String toAcc,
            @PathVariable String ifsc,
            @PathVariable double amount) {
        return ResponseEntity.ok(service.transfer(username, toAcc, ifsc, amount));
    }
}
